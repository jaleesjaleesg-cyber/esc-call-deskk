NODE_ENV=production

# Set strong private values in Hostinger environment variables. Never commit them.
ESC_AROOSA_PASSWORD=
ESC_JALEES_PASSWORDS=

# Required before enabling GitHub auto-deployment.
ESC_REQUIRE_DATABASE=1
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional Azure V9 bridge. The OTP recipient, OTP signing secret, Gemini keys,
# Companies House key and Azure credentials must remain on Azure, never here.
ESC_RESEARCH_CONTROL_URL=
ESC_RESEARCH_BRIDGE_SECRET=
ESC_RESEARCH_BRIDGE_TIMEOUT_MS=15000
